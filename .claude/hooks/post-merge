#!/bin/sh
# post-merge — this suite ships no post-merge logic of its own.
#
# It exists so that YOUR hook still runs. core.hooksPath redirects git's entire hook
# lookup to this directory, so without this file a personal .git/hooks/post-merge is
# skipped in silence — no error, no output, nothing to grep for.
#
# Put yours at .git/hooks/post-merge.local and make it executable. See _chain.
exec "$(dirname "$0")/_chain" post-merge "$@"
