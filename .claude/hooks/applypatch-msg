#!/bin/sh
# applypatch-msg — this suite ships no applypatch-msg logic of its own.
#
# It exists so that YOUR hook still runs. core.hooksPath redirects git's entire hook
# lookup to this directory, so without this file a personal .git/hooks/applypatch-msg is
# skipped in silence — no error, no output, nothing to grep for.
#
# Put yours at .git/hooks/applypatch-msg.local and make it executable. See _chain.
exec "$(dirname "$0")/_chain" applypatch-msg "$@"
