#!/bin/sh
# Pre-commit: refuse a commit that leaves the enforcement layer disarmed.
#
# Install: automatic. `npm install` runs scripts/install-hooks.mjs via npm's `prepare`,
# which sets core.hooksPath to this directory — so this committed file IS the live hook
# and editing it takes effect immediately. To arm a clone by hand: npm run install-git-hooks
#
# THIS IS STILL THE WEAKEST OF THE THREE PLACEMENTS, and it is worth knowing why before
# relying on it. core.hooksPath is local git config, which no commit can carry, so this
# is armed only where someone ran an install; and `git commit --no-verify` skips it
# regardless. So it catches *your own* mistakes on *this* machine and nothing else.
#
# The copy that actually holds is `npm test` in .github/workflows/test.yml — committed,
# run on someone else's machine, and not switchable off by editing the files it checks.
# Pre-commit is the fast local echo of that, not a substitute for it.
#
# Pre-commit rather than post-commit on purpose: post-commit runs after the commit
# exists, so it can only ever narrate a disarmed state it was too late to prevent.
#
# YOUR OWN PRE-COMMIT HOOK still runs — put it at .git/hooks/pre-commit.local and make
# it executable. It is chained at the bottom of this file. The rename is not busywork:
# core.hooksPath redirects git's ENTIRE hook lookup, so a hook left at the usual
# .git/hooks/pre-commit is skipped in total silence, with no error and no output. The
# .local name is the one thing here that cannot be silently ignored, because this file
# is what goes looking for it.
#
# The same holds for every other hook name — see README.md in this directory for which
# are covered, which deliberately are not, and why.

# The FULL suite, not a fast subset. It runs in ~2s with no dependencies, and the
# tests most worth having here are the cheap ones — the process tests that catch a
# renamed script leaving four skills' instructions stale. Those cost nothing and are
# exactly what a commit is likely to break.
if ! npm test --silent; then
  echo ""
  echo "pre-commit: refusing — the suite is red."
  echo ""
  echo "  guards disarmed?  fix the config, or update REQUIRED in"
  echo "                    scripts/verify-guards.mjs in the same commit."
  echo "  process test?     a rename left an instruction, link or handoff stale."
  echo "  schema test?      an entry is malformed, or a convention changed and its"
  echo "                    checker did not (change doc + checker + skills together)."
  echo ""
  echo "To commit anyway: git commit --no-verify  (CI still runs all of this)."
  exit 1
fi

# Hand off to your personal hook, if you have one. The suite's gate runs first so the
# common failure is the cheap one. Every hook in this directory ends this way; the
# reasoning about exec, stdin and exit codes lives in _chain rather than being copied
# fifteen times.
exec "$(dirname "$0")/_chain" pre-commit "$@"
