#!/bin/sh
# post-checkout — this suite ships no post-checkout logic of its own.
#
# It exists so that YOUR hook still runs. core.hooksPath redirects git's entire hook
# lookup to this directory, so without this file a personal .git/hooks/post-checkout is
# skipped in silence — no error, no output, nothing to grep for.
#
# Put yours at .git/hooks/post-checkout.local and make it executable. See _chain.
exec "$(dirname "$0")/_chain" post-checkout "$@"
