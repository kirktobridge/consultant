#!/bin/sh
# prepare-commit-msg — this suite ships no prepare-commit-msg logic of its own.
#
# It exists so that YOUR hook still runs. core.hooksPath redirects git's entire hook
# lookup to this directory, so without this file a personal .git/hooks/prepare-commit-msg is
# skipped in silence — no error, no output, nothing to grep for.
#
# Put yours at .git/hooks/prepare-commit-msg.local and make it executable. See _chain.
exec "$(dirname "$0")/_chain" prepare-commit-msg "$@"
