#!/bin/sh
# pre-auto-gc — this suite ships no pre-auto-gc logic of its own.
#
# It exists so that YOUR hook still runs. core.hooksPath redirects git's entire hook
# lookup to this directory, so without this file a personal .git/hooks/pre-auto-gc is
# skipped in silence — no error, no output, nothing to grep for.
#
# Put yours at .git/hooks/pre-auto-gc.local and make it executable. See _chain.
exec "$(dirname "$0")/_chain" pre-auto-gc "$@"
