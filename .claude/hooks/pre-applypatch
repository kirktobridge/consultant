#!/bin/sh
# pre-applypatch — this suite ships no pre-applypatch logic of its own.
#
# It exists so that YOUR hook still runs. core.hooksPath redirects git's entire hook
# lookup to this directory, so without this file a personal .git/hooks/pre-applypatch is
# skipped in silence — no error, no output, nothing to grep for.
#
# Put yours at .git/hooks/pre-applypatch.local and make it executable. See _chain.
exec "$(dirname "$0")/_chain" pre-applypatch "$@"
