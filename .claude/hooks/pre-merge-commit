#!/bin/sh
# pre-merge-commit — this suite ships no pre-merge-commit logic of its own.
#
# It exists so that YOUR hook still runs. core.hooksPath redirects git's entire hook
# lookup to this directory, so without this file a personal .git/hooks/pre-merge-commit is
# skipped in silence — no error, no output, nothing to grep for.
#
# Put yours at .git/hooks/pre-merge-commit.local and make it executable. See _chain.
exec "$(dirname "$0")/_chain" pre-merge-commit "$@"
