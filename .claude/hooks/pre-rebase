#!/bin/sh
# pre-rebase — this suite ships no pre-rebase logic of its own.
#
# It exists so that YOUR hook still runs. core.hooksPath redirects git's entire hook
# lookup to this directory, so without this file a personal .git/hooks/pre-rebase is
# skipped in silence — no error, no output, nothing to grep for.
#
# Put yours at .git/hooks/pre-rebase.local and make it executable. See _chain.
exec "$(dirname "$0")/_chain" pre-rebase "$@"
