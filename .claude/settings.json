{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-audit.mjs\" 2>&1 || true",
            "timeout": 15,
            "statusMessage": "Auditing what the last session left"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/edit-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/backlog-schema-check.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking backlog schema"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/verify-guards.mjs\"",
            "timeout": 10,
            "statusMessage": "Verifying guards are armed"
          }
        ]
      }
    ]
  }
}
