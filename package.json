{
  "name": "consultant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A doc-driven working loop: Claude Code skills plus the documents they read and write.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\" && npm run check:docs && npm run check:guards && npm run check:manifest && npm run check:commits",
    "test:clean": "node scripts/test-clean.mjs",
    "check:docs": "node scripts/backlog-schema-check.mjs --all",
    "check:guards": "node scripts/verify-guards.mjs --all",
    "check:manifest": "node scripts/manifest.mjs --check",
    "check:commits": "node scripts/commit-ids.mjs --history",
    "audit": "node scripts/session-audit.mjs",
    "groom": "node scripts/groom.mjs",
    "queue": "node scripts/queue.mjs",
    "history": "node scripts/history.mjs",
    "status": "node scripts/status.mjs",
    "eval": "node evals/run.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "install-git-hooks": "node scripts/install-hooks.mjs"
  }
}
